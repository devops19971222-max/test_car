{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && cd frontend/app/project && npm install",
  "buildCommand": "cd frontend/app/project && npm run build:client",
  "outputDirectory": "frontend/app/project/dist/spa",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
