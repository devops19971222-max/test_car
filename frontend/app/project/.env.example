# CarNextDrive environment variables
# Copy to .env and fill in values:
#   cp .env.example .env
#
# Restart the dev server after editing (.env is not hot-reloaded).

# ── Stripe (required for booking / checkout) ──────────────────────────────
# Dashboard → Developers → API keys (use sk_test_… until you go live)
STRIPE_SECRET_KEY=sk_test_your_key_here

# Dashboard → Developers → Webhooks → signing secret (whsec_…)
# Leave blank for local dev; required in production for webhook verification.
STRIPE_WEBHOOK_SECRET=

# ── Cloudinary (optional — server-side /api/upload) ───────────────────────
# Signup.tsx also uploads directly from the browser using a hardcoded cloud
# name and preset; these vars power the server upload route instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Formspree (optional — application email after payment) ──────────────
# Your Formspree form endpoint, e.g. https://formspree.io/f/xxxxxxxx
FORMSPREE_ENDPOINT=

# ── Site URL (optional) ─────────────────────────────────────────────────
# Used as Origin/Referer when posting to Formspree. Netlify sets URL
# automatically in production; set this for local testing if needed.
PUBLIC_SITE_URL=http://localhost:3000

# ── Dev / server ports (optional) ───────────────────────────────────────
# Standalone API server (npx tsx server/dev-server.ts)
API_PORT=8001

# Production Node build (npm start)
# PORT=3000

# Python Emergent wrapper only (backend/server.py)
# NODE_API_PORT=8002

# ── Misc (optional) ───────────────────────────────────────────────────────
# Custom message for GET /api/ping
# PING_MESSAGE=ping
